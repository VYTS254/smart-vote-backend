// Prisma Schema for Smart Vote System

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
// ==================== ENUMS ====================

enum AccountStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum RoleName {
  ADMIN
  ELECTION_OFFICER
  STUDENT
  DELEGATE
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum PartyStatus {
  ACTIVE
  INACTIVE
}

enum ElectionStage {
  DEPARTMENTAL
  STUDENT_COUNCIL
}

enum ElectionStatus {
  DRAFT
  READY
  OPEN
  CLOSED
  VERIFIED
  PUBLISHED
}

enum VotingMethod {
  SINGLE_WINNER
  MULTI_SEAT
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum QualificationStatus {
  QUALIFIED
  DISQUALIFIED
}

enum VerificationStatus {
  PENDING
  VERIFIED
  PUBLISHED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
}

// ==================== CORE ENTITIES ====================

model Department {
  id        String           @id @default(uuid())
  name      String           @unique
  code      String           @unique
  status    DepartmentStatus @default(ACTIVE)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  users                 User[]
  positions             Position[]
  delegateQualifications DelegateQualification[]

  @@map("departments")
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String
  createdAt   DateTime @default(now())

  // Relations
  userRoles UserRole[]

  @@map("roles")
}

model User {
  id                         String        @id @default(uuid())
  studentRegistrationNumber  String        @unique
  fullName                   String
  email                      String        @unique
  passwordHash               String
  departmentId               String
  accountStatus              AccountStatus @default(ACTIVE)
  createdAt                  DateTime      @default(now())
  updatedAt                  DateTime      @updatedAt

  // Relations
  department             Department              @relation(fields: [departmentId], references: [id])
  roles                  UserRole[]
  candidates             Candidate[]
  voterEligibilities     VoterEligibility[]
  delegateQualifications DelegateQualification[]
  notifications          Notification[]
  auditLogs              AuditLog[]
  resultsVerified        Result[]

  @@index([departmentId])
  @@index([email])
  @@index([studentRegistrationNumber])
  @@map("users")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id])

  @@id([userId, roleId])
  @@map("user_roles")
}

model Party {
  id           String      @id @default(uuid())
  name         String      @unique
  abbreviation String      @unique
  logoUrl      String?
  description  String?
  status       PartyStatus @default(ACTIVE)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Relations
  candidates Candidate[]

  @@map("parties")
}

// ==================== ELECTION ENTITIES ====================

model Election {
  id                 String         @id @default(uuid())
  name               String
  stage              ElectionStage
  academicYear       String
  startAt            DateTime
  endAt              DateTime
  status             ElectionStatus @default(DRAFT)
  rulesConfiguration Json? // Stores election-specific rules
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  // Relations
  positions              Position[]
  candidates             Candidate[]
  voterEligibilities     VoterEligibility[]
  ballotSubmissions      BallotSubmission[]
  results                Result[]
  delegateQualifications DelegateQualification[]

  @@index([status])
  @@index([stage])
  @@map("elections")
}

model Position {
  id                      String        @id @default(uuid())
  electionId              String
  departmentId            String? // Null for Student Council positions
  name                    String
  numberOfSeats           Int           @default(1)
  votingMethod            VotingMethod  @default(SINGLE_WINNER)
  eligibilityConfiguration Json? // Stores eligibility rules
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  // Relations
  election           Election           @relation(fields: [electionId], references: [id], onDelete: Cascade)
  department         Department?        @relation(fields: [departmentId], references: [id])
  candidates         Candidate[]
  voterEligibilities VoterEligibility[]
  ballotSubmissions  BallotSubmission[]
  results            Result[]

  @@unique([electionId, departmentId, name])
  @@index([electionId])
  @@index([departmentId])
  @@map("positions")
}

model Candidate {
  id              String         @id @default(uuid())
  userId          String
  electionId      String
  positionId      String
  partyId         String? // Null for independent candidates
  manifesto       String?
  photoUrl        String?
  approvalStatus  ApprovalStatus @default(PENDING)
  rejectionReason String?
  ballotNumber    Int? // Assigned after approval
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  user            User             @relation(fields: [userId], references: [id])
  election        Election         @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position        Position         @relation(fields: [positionId], references: [id], onDelete: Cascade)
  party           Party?           @relation(fields: [partyId], references: [id])
  voteSelections  VoteSelection[]
  results         Result[]

  @@unique([userId, electionId, positionId])
  @@index([electionId])
  @@index([positionId])
  @@index([approvalStatus])
  @@map("candidates")
}

// ==================== VOTING ENTITIES (PRIVACY-PRESERVING DESIGN) ====================

model VoterEligibility {
  id         String   @id @default(uuid())
  userId     String
  electionId String
  positionId String
  eligible   Boolean  @default(true)
  createdAt  DateTime @default(now())

  // Relations
  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  election          Election           @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position          Position           @relation(fields: [positionId], references: [id], onDelete: Cascade)
  ballotSubmissions BallotSubmission[]

  @@unique([userId, electionId, positionId])
  @@index([electionId])
  @@index([userId])
  @@map("voter_eligibility")
}

model BallotSubmission {
  id                 String   @id @default(uuid())
  submissionToken    String   @unique @default(uuid())
  electionId         String
  positionId         String
  voterEligibilityId String
  submittedAt        DateTime @default(now())

  // Relations
  election         Election          @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position         Position          @relation(fields: [positionId], references: [id], onDelete: Cascade)
  voterEligibility VoterEligibility  @relation(fields: [voterEligibilityId], references: [id])
  voteSelections   VoteSelection[]

  @@unique([voterEligibilityId, positionId]) // Prevents duplicate voting
  @@index([electionId])
  @@index([positionId])
  @@map("ballot_submissions")
}

model VoteSelection {
  id                 String   @id @default(uuid())
  ballotSubmissionId String
  candidateId        String
  createdAt          DateTime @default(now())

  // Relations
  ballotSubmission BallotSubmission @relation(fields: [ballotSubmissionId], references: [id], onDelete: Cascade)
  candidate        Candidate        @relation(fields: [candidateId], references: [id])

  @@index([ballotSubmissionId])
  @@index([candidateId])
  @@map("vote_selections")
}

// ==================== DELEGATE QUALIFICATION ====================

model DelegateQualification {
  id                   String              @id @default(uuid())
  studentId            String
  departmentId         String
  qualifyingElectionId String
  positionRank         Int // 1-5 for top 5 delegates
  qualificationStatus  QualificationStatus @default(QUALIFIED)
  verifiedAt           DateTime?
  createdAt            DateTime            @default(now())

  // Relations
  student            User       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  department         Department @relation(fields: [departmentId], references: [id])
  qualifyingElection Election   @relation(fields: [qualifyingElectionId], references: [id])

  @@unique([studentId, qualifyingElectionId])
  @@index([studentId])
  @@index([qualifyingElectionId])
  @@map("delegate_qualifications")
}

// ==================== RESULTS ====================

model Result {
  id                 String             @id @default(uuid())
  electionId         String
  positionId         String
  candidateId        String
  voteTotal          Int
  votePercentage     Float
  rank               Int
  isWinner           Boolean            @default(false)
  verificationStatus VerificationStatus @default(PENDING)
  verifiedBy         String?
  verifiedAt         DateTime?
  publishedAt        DateTime?
  createdAt          DateTime           @default(now())

  // Relations
  election  Election  @relation(fields: [electionId], references: [id], onDelete: Cascade)
  position  Position  @relation(fields: [positionId], references: [id], onDelete: Cascade)
  candidate Candidate @relation(fields: [candidateId], references: [id])
  verifier  User?     @relation(fields: [verifiedBy], references: [id])

  @@unique([electionId, positionId, candidateId])
  @@index([electionId])
  @@index([positionId])
  @@map("results")
}

// ==================== NOTIFICATIONS & AUDIT ====================

model Notification {
  id        String           @id @default(uuid())
  userId    String? // Null for system-wide notifications
  title     String
  message   String
  type      NotificationType @default(INFO)
  read      Boolean          @default(false)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resourceType])
  @@index([createdAt])
  @@map("audit_logs")
}
