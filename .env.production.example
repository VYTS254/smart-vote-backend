# Production Database Configuration
DATABASE_URL="postgresql://prod_user:prod_password@your-db-host:5432/smart_vote_prod?schema=public"

# JWT Configuration (Generate secure random strings)
JWT_SECRET="production-jwt-secret-minimum-32-characters-long"
JWT_EXPIRES_IN="7d"
JWT_REFRESH_SECRET="production-refresh-secret-minimum-32-characters-long"
JWT_REFRESH_EXPIRES_IN="30d"

# Server Configuration
NODE_ENV="production"
PORT=3000

# CORS Configuration (Your mobile app domains)
CORS_ORIGIN="https://yourdomain.com,https://api.yourdomain.com"

# Rate Limiting (More restrictive in production)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50

# App Configuration
APP_NAME="SmartVote"
UNIVERSITY_NAME="Your University Name"
ACADEMIC_YEAR="2024/2025"

# Optional: Logging
LOG_LEVEL="error"
